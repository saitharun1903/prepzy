{
  "name": "@elevate/extension",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Elevate browser extension (Chrome/Edge, Manifest V3): capture a job posting from the current tab and track its analysis.",
  "scripts": {
    "build": "node scripts/build.mjs --mode=dev",
    "build:release": "node scripts/build.mjs --mode=release",
    "build:hosted": "node scripts/build.mjs --mode=hosted",
    "package": "node scripts/package.mjs",
    "package:hosted": "node scripts/package.mjs --hosted",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "validate": "node scripts/validate.mjs dist && node scripts/validate.mjs dist-release --release --if-present"
  },
  "dependencies": {
    "@elevate/api-client": "0.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@types/chrome": "0.3.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
