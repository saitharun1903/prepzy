# Server-only: base URL of the Elevate FastAPI service (no trailing slash).
# The browser never talks to the API directly; all calls go through /api/proxy on this app.
ELEVATE_API_URL=http://127.0.0.1:8000

# Optional, server-only: comma-separated extra origins accepted by the CSRF Origin check
# (the origin the app is served from is always accepted), e.g. http://localhost:3000
# ELEVATE_APP_ORIGINS=

# Public: Chrome extension id used by /extension/connect (chrome.runtime.sendMessage).
NEXT_PUBLIC_ELEVATE_EXTENSION_ID=bjhbbpnbmichlooillmiaeofcioofkni
