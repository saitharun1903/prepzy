# Elevate configuration. Copy is generated by `python scripts/init_env.py` (fills secrets with random values).
# [server] = server-only secret/config, never shipped to a browser bundle.
# [public] = safe to expose to browser code.
# REQUIRED unless marked (optional).

# ---- Environment ----------------------------------------------------------
# local | test | production. Development-only behaviour (seed command, docs UI) is refused when production.
ELEVATE_ENV=local
# [public] Web dashboard origin (used for CORS + extension connect page)
ELEVATE_WEB_URL=http://localhost:3000
# [server] API base URL as seen by the Next.js server proxy
ELEVATE_API_URL=http://127.0.0.1:8000
# [server] Comma-separated extra CORS origins. The extension origin is added from ELEVATE_EXTENSION_IDS.
ELEVATE_ALLOWED_ORIGINS=http://localhost:3000
# [server] Comma-separated Chrome/Edge extension IDs allowed to call the API (dev ID is derived from apps/extension/key)
ELEVATE_EXTENSION_IDS=

# ---- Database (PostgreSQL 17 + pgvector) -----------------------------------
ELEVATE_DB_PORT=5433
# [server] Owner role: used only by migrations/bootstrap.
ELEVATE_DB_OWNER_PASSWORD=__generate__
# [server] Least-privilege runtime role used by API + worker.
ELEVATE_DB_APP_PASSWORD=__generate__
ELEVATE_DATABASE_URL=postgresql+psycopg://elevate_app:${ELEVATE_DB_APP_PASSWORD}@127.0.0.1:5433/elevate
ELEVATE_MIGRATION_DATABASE_URL=postgresql+psycopg://elevate_owner:${ELEVATE_DB_OWNER_PASSWORD}@127.0.0.1:5433/elevate
ELEVATE_DB_POOL_SIZE=5

# ---- Authentication (first-party, see docs/DECISIONS.md D-03) ----------------
# [server] HMAC key for 15-minute access JWTs (HS256). >= 32 random bytes.
ELEVATE_JWT_SECRET=__generate__
ELEVATE_JWT_ISSUER=elevate-local
ELEVATE_JWT_AUDIENCE=elevate-api
ELEVATE_ACCESS_TOKEN_MINUTES=15
ELEVATE_REFRESH_TOKEN_DAYS=30
# [server] Comma-separated emails granted the admin role at registration/login (server-side only).
ELEVATE_ADMIN_EMAILS=

# ---- Inference (local Ollama; external providers disabled by default) -------
ELEVATE_LLM_PROVIDER=ollama
# [server] Trusted operator endpoint. Never taken from a client request.
ELEVATE_OLLAMA_URL=http://127.0.0.1:11434
ELEVATE_LLM_MODEL=qwen2.5-coder:7b
ELEVATE_LLM_TEMPERATURE=0.1
ELEVATE_LLM_NUM_CTX=8192
ELEVATE_LLM_MAX_OUTPUT_TOKENS=2048
ELEVATE_LLM_TIMEOUT_SECONDS=240
ELEVATE_LLM_CONCURRENCY=1
ELEVATE_EMBED_MODEL=nomic-embed-text
ELEVATE_EMBED_DIM=768

# ---- Retrieval --------------------------------------------------------------
ELEVATE_RAG_TOP_K=6
# Cosine distance ceiling; passages further than this are not used as evidence.
ELEVATE_RAG_MAX_DISTANCE=0.55
ELEVATE_CHUNK_CHARS=1200
ELEVATE_CHUNK_OVERLAP=150

# ---- Storage & limits -------------------------------------------------------
# [server] Private directory outside any web root (resume files, exports).
ELEVATE_DATA_DIR=./data
ELEVATE_MAX_UPLOAD_MB=5
ELEVATE_MAX_RESUME_PAGES=10
ELEVATE_MAX_JOB_TEXT_CHARS=60000
ELEVATE_EXPORT_RETENTION_HOURS=24

# ---- Worker -----------------------------------------------------------------
ELEVATE_WORKER_CONCURRENCY=1
ELEVATE_WORKER_LEASE_SECONDS=90
ELEVATE_WORKER_POLL_SECONDS=2
ELEVATE_OPERATION_MAX_ATTEMPTS=3
ELEVATE_OPERATION_DEADLINE_MINUTES=20
ELEVATE_MAX_QUEUED_OPERATIONS_PER_USER=10

# ---- Rate limits (single-process limiter; see docs/SECURITY.md) -------------
ELEVATE_AUTH_RATE_PER_MINUTE=10

# ---- Logging ----------------------------------------------------------------
ELEVATE_LOG_LEVEL=INFO

# ---- Optional integrations (all disabled; not implemented) -------------------
# ELEVATE_SMTP_URL=            (optional) email delivery – not implemented
# ELEVATE_OCR_ENABLED=false    (optional) OCR – not implemented
